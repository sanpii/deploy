#!/bin/bash

set -euo pipefail

remove_oldest()
{
    ls -1tpd v* | tail -n +6 | xargs -I {} rm -r -- {}
}

version=${1-$(wget -O - -q https://api.github.com/repos/roundcube/roundcubemail/releases/latest | jq --raw-output .tag_name)}

echo "Update to $version"
if [[ ! -d "v$version" ]]
then
    wget --continue "https://github.com/roundcube/roundcubemail/releases/download/$version/roundcubemail-$version-complete.tar.gz" -O - | tar xz
    mv "roundcubemail-$version" "v$version"
fi

ln --symbolic --force /etc/app/roundcube/config/config.inc.php "v$version/config/config.inc.php"
ln --no-target-directory --force --symbolic "v$version" current
sudo systemctl reload php8.4-fpm
